{% extends 'base.html.twig' %}

{% block navbar %}{% endblock %}
{% block title %}Market Trends{% endblock %}

{% block stylesheets %}
<style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap');

    :root {
        --green:        #1D9E75;
        --green-dark:   #0F6E56;
        --green-deep:   #085041;
        --green-light:  #E1F5EE;
        --green-mid:    #9FE1CB;
        --blue:         #378ADD;
        --blue-dark:    #185FA5;
        --blue-light:   #E6F1FB;
        --blue-mid:     #B5D4F4;
        --red:          #E24B4A;
        --red-dark:     #A32D2D;
        --red-light:    #FCEBEB;
        --red-mid:      #F7C1C1;
        --amber:        #BA7517;
        --amber-light:  #FAEEDA;
        --border:       rgba(0,0,0,.09);
        --border-soft:  rgba(0,0,0,.05);
        --bg:           #F5F6F8;
        --surface:      #FFFFFF;
        --surface-2:    #F9FAFB;
        --text:         #111827;
        --text-2:       #374151;
        --muted:        #6B7280;
        --radius:       12px;
        --radius-sm:    8px;
        --radius-xs:    6px;
        --shadow-sm:    0 1px 3px rgba(0,0,0,.06);
        --shadow-md:    0 4px 12px rgba(0,0,0,.08);
        --shadow-lg:    0 8px 24px rgba(0,0,0,.1);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        line-height: 1.55;
    }

    .page-wrap { max-width: 1280px; margin: 0 auto; padding: 28px 24px 64px; }

    /* ── TOPBAR ── */
    .topbar {
        background: var(--surface);
        border-bottom: 0.5px solid var(--border);
        position: sticky; top: 0; z-index: 100;
    }
    .topbar-inner {
        max-width: 1280px; margin: 0 auto;
        padding: 0 24px; height: 52px;
        display: flex; align-items: center; gap: 12px;
    }
    .topbar-brand { font-size: 17px; font-weight: 700; color: var(--text); letter-spacing: -.03em; text-decoration: none; }
    .topbar-brand em { color: var(--green); font-style: normal; }
    .topbar-sep { width: 1px; height: 17px; background: var(--border); flex-shrink: 0; }
    .topbar-crumb { display: flex; align-items: center; gap: 5px; font-size: 12px; color: var(--muted); }
    .topbar-crumb a { color: var(--muted); text-decoration: none; }
    .topbar-crumb a:hover { color: var(--text); }
    .topbar-crumb-cur { color: var(--text); font-weight: 500; }
    .topbar-right { margin-left: auto; display: flex; gap: 6px; align-items: center; }
    .tb-btn {
        height: 30px; padding: 0 12px; font-size: 12px; font-weight: 500;
        font-family: 'Inter', sans-serif;
        border-radius: var(--radius-sm); cursor: pointer;
        text-decoration: none; border: 0.5px solid var(--border);
        background: transparent; color: var(--text-2);
        transition: all .15s; white-space: nowrap;
        display: inline-flex; align-items: center; gap: 5px;
    }
    .tb-btn:hover { background: var(--surface-2); color: var(--text); }
    .tb-btn svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; }

    /* ── PAGE HEADER ── */
    .page-header {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius);
        padding: 28px 32px;
        margin-bottom: 24px;
        display: flex; align-items: center; justify-content: space-between;
        gap: 20px; flex-wrap: wrap;
        box-shadow: var(--shadow-sm);
    }
    .page-header-eyebrow {
        font-size: 10px; font-weight: 600; letter-spacing: .1em;
        text-transform: uppercase; color: var(--green);
        margin-bottom: 5px; display: flex; align-items: center; gap: 7px;
    }
    .live-dot {
        width: 7px; height: 7px; border-radius: 50%;
        background: var(--green); display: inline-block;
        animation: blink 1.6s infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.25} }
    .page-header-title {
        font-size: clamp(18px, 2.5vw, 24px);
        font-weight: 700; color: var(--text);
        letter-spacing: -.03em; line-height: 1.1;
    }
    .page-header-sub { font-size: 12.5px; color: var(--muted); margin-top: 5px; }
    .header-badges { display: flex; gap: 10px; flex-wrap: wrap; }
    .header-badge {
        background: var(--surface-2); border: 0.5px solid var(--border);
        border-radius: var(--radius-sm); padding: 12px 20px; text-align: center;
        min-width: 90px;
    }
    .header-badge-val {
        font-size: 24px; font-weight: 700; color: var(--text);
        font-family: 'JetBrains Mono', monospace; line-height: 1;
        letter-spacing: -.04em;
    }
    .header-badge-lbl {
        font-size: 10px; font-weight: 600; text-transform: uppercase;
        letter-spacing: .07em; color: var(--muted); margin-top: 3px;
    }

    /* ── CATEGORY SECTION ── */
    .category-section { margin-bottom: 28px; }
    .category-header {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 12px; padding-bottom: 10px;
        border-bottom: 0.5px solid var(--border);
    }
    .category-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: var(--green); flex-shrink: 0;
    }
    .category-name {
        font-size: 11px; font-weight: 600; text-transform: uppercase;
        letter-spacing: .09em; color: var(--text-2);
    }
    .category-count {
        font-size: 11px; font-weight: 500; color: var(--muted);
        background: var(--surface-2); border: 0.5px solid var(--border);
        border-radius: 20px; padding: 1px 9px;
    }

    /* ── CARDS GRID ── */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 12px;
    }

    /* ── QUOTE CARD ── */
    .quote-card {
        background: var(--surface);
        border: 0.5px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 20px;
        display: flex; flex-direction: column;
        box-shadow: var(--shadow-sm);
        transition: box-shadow .2s, transform .2s, border-color .2s;
        position: relative; overflow: hidden;
    }
    .quote-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
        border-color: rgba(29,158,117,.25);
    }
    .quote-card-top-accent {
        position: absolute; top: 0; left: 0; right: 0; height: 2.5px;
        background: var(--green); opacity: 0;
        transition: opacity .2s;
    }
    .quote-card:hover .quote-card-top-accent { opacity: 1; }

    .card-row-top {
        display: flex; align-items: flex-start;
        justify-content: space-between; margin-bottom: 10px;
    }
    .card-symbol {
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px; font-weight: 700;
        color: var(--muted);
        background: var(--surface-2); border: 0.5px solid var(--border);
        padding: 2px 8px; border-radius: var(--radius-xs);
        letter-spacing: .04em;
    }
    .card-currency {
        font-size: 10px; font-weight: 600;
        color: var(--blue-dark);
        background: var(--blue-light); border: 0.5px solid var(--blue-mid);
        padding: 2px 8px; border-radius: var(--radius-xs);
    }
    .card-name {
        font-weight: 600; font-size: 13px; color: var(--text);
        margin-bottom: 10px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .card-price {
        font-size: 24px; font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        color: var(--text); letter-spacing: -.04em;
        line-height: 1; margin-bottom: 7px;
    }
    .card-change {
        display: inline-flex; align-items: center; gap: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px; font-weight: 700;
        padding: 3px 9px; border-radius: 20px;
        width: fit-content;
    }
    .card-change.up   { color: var(--green-deep); background: var(--green-light); border: 0.5px solid var(--green-mid); }
    .card-change.down { color: var(--red-dark);   background: var(--red-light);   border: 0.5px solid var(--red-mid); }

    .card-error {
        color: var(--muted); font-size: 12px; font-weight: 500;
        font-style: italic; margin-top: 6px;
    }

    .btn-trend {
        display: inline-flex; align-items: center; gap: 5px;
        margin-top: auto; padding-top: 14px;
        font-size: 11px; font-weight: 600;
        font-family: 'Inter', sans-serif;
        background: var(--green-light); border: 0.5px solid var(--green-mid);
        color: var(--green-dark);
        padding: 6px 12px; border-radius: var(--radius-sm);
        text-decoration: none;
        transition: all .15s;
        width: fit-content; margin-top: 14px;
    }
    .btn-trend:hover {
        background: var(--green); border-color: var(--green);
        color: #fff; transform: translateY(-1px);
    }
    .btn-trend svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }

    /* ── EMPTY / ERROR STATES ── */
    .empty-state {
        background: var(--surface); border: 0.5px dashed var(--border);
        border-radius: var(--radius); padding: 3rem 2rem; text-align: center;
        grid-column: 1/-1;
    }
    .empty-state-icon { font-size: 28px; margin-bottom: .75rem; display: block; }
    .empty-state-text { font-size: 13px; color: var(--muted); }

    /* ── SCROLLBAR ── */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 99px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

    /* ── RESPONSIVE ── */
    @media (max-width: 600px) {
        .page-wrap { padding: 16px 16px 48px; }
        .page-header { padding: 20px; }
        .cards-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 400px) {
        .cards-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}

<nav class="topbar">
    <div class="topbar-inner">
        <a href="{{ path('objectif_index') }}" class="topbar-brand">Findi<em>nari</em></a>
        <div class="topbar-sep"></div>
        <div class="topbar-crumb">
            <a href="{{ path('objectif_index') }}">Dashboard</a>
            <span>›</span>
            <span class="topbar-crumb-cur">Market Trends</span>
        </div>
        <div class="topbar-right">
            <a href="{{ path('objectif_index') }}" class="tb-btn">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Back to goals
            </a>
        </div>
    </div>
</nav>

<div class="page-wrap">

    {# ── PAGE HEADER ── #}
    <div class="page-header">
        <div>
            <div class="page-header-eyebrow">
                <span class="live-dot"></span>
                Live data
            </div>
            <div class="page-header-title">Market Trends</div>
            <div class="page-header-sub">Real-time quotes — refreshed every 5 minutes</div>
        </div>
        <div class="header-badges">
            {% set totalSymbols = 0 %}
            {% for cat, symbols in categories %}
                {% set totalSymbols = totalSymbols + symbols|length %}
            {% endfor %}
            <div class="header-badge">
                <div class="header-badge-val">{{ totalSymbols }}</div>
                <div class="header-badge-lbl">Assets tracked</div>
            </div>
            <div class="header-badge">
                <div class="header-badge-val">{{ categories|length }}</div>
                <div class="header-badge-lbl">Categories</div>
            </div>
        </div>
    </div>

    {# ── CATEGORIES ── #}
    {% for categoryName, symbols in categories %}
        <div class="category-section">
            <div class="category-header">
                <div class="category-dot"></div>
                <span class="category-name">{{ categoryName }}</span>
                <span class="category-count">{{ symbols|length }} asset{{ symbols|length != 1 ? 's' : '' }}</span>
            </div>

            <div class="cards-grid">
                {% for symbol in symbols %}
                    {% set q = quotes[symbol] ?? null %}

                    <div class="quote-card">
                        <div class="quote-card-top-accent"></div>

                        {% if q is not null and q['name'] is defined %}

                            <div class="card-row-top">
                                <span class="card-symbol">{{ symbol }}</span>
                                <span class="card-currency">{{ q['currency'] ?? 'USD' }}</span>
                            </div>

                            <div class="card-name">{{ q['name'] }}</div>

                            <div class="card-price">
                                {{ q['close']|number_format(2, '.', ' ') }}
                            </div>

                            {% set change = q['percent_change'] ?? 0 %}
                            <div class="card-change {{ change >= 0 ? 'up' : 'down' }}">
                                {% if change >= 0 %}
                                    <svg viewBox="0 0 24 24" style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:3"><polyline points="18 15 12 9 6 15"/></svg>
                                {% else %}
                                    <svg viewBox="0 0 24 24" style="width:10px;height:10px;stroke:currentColor;fill:none;stroke-width:3"><polyline points="6 9 12 15 18 9"/></svg>
                                {% endif %}
                                {{ change|number_format(2, '.', '') }}% today
                            </div>

                            <a href="{{ path('stock_trend', {symbol: symbol}) }}" class="btn-trend">
                                <svg viewBox="0 0 24 24"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                                View trend
                            </a>

                        {% else %}

                            <div class="card-row-top">
                                <span class="card-symbol">{{ symbol }}</span>
                            </div>
                            <div class="card-name">{{ symbol }}</div>
                            <div class="card-error">Data unavailable</div>

                        {% endif %}
                    </div>

                {% else %}

                    <div class="empty-state">
                        <span class="empty-state-icon">📭</span>
                        <div class="empty-state-text">No assets in this category.</div>
                    </div>

                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="empty-state" style="margin-top:2rem">
            <span class="empty-state-icon">📡</span>
            <div class="empty-state-text">No market data available at the moment. Please try again shortly.</div>
        </div>
    {% endfor %}

</div>
{% endblock %}

