    <script>
    // ==========================================
// MONEY TRANSFER FUNCTIONS
// ==========================================

function openTransferModal() {
    document.getElementById('transferWindow').classList.add('open');
    resetTransferModal();
    loadTransferWallets();
}

function closeTransferModal() {
    document.getElementById('transferWindow').classList.remove('open');
}

function showTransferStep1() {
    document.getElementById('transferStep1').style.display = 'block';
    document.getElementById('transferStep2').style.display = 'none';
    document.getElementById('transferBackBtn').style.display = 'none';
    document.getElementById('transferSendBtn').style.display = 'none';
}

function resetTransferModal() {
    showTransferStep1();
    document.getElementById('transferSearchUser').value = '';
    document.getElementById('transferSearchResults').innerHTML = '';
    document.getElementById('transferReceiverId').value = '';
    document.getElementById('transferReceiverName').textContent = '';
    document.getElementById('transferAmount').value = '';
    document.getElementById('transferMessage').value = '';
    document.getElementById('transferDevise').textContent = '—';
    document.getElementById('transferBalanceInfo').textContent = '';
    document.getElementById('transferWarning').textContent = '';
    document.getElementById('transferSummaryAmount').textContent = '0.00';
    document.getElementById('transferSummaryReceiver').textContent = '—';
}

// Load wallets for transfer
function loadTransferWallets() {
    fetch('/wallet/api/list')
        .then(r => r.json())
        .then(data => {
            const select = document.getElementById('transferWalletId');
            select.innerHTML = '<option value="">-- Select your wallet --</option>';
            (data.wallets || []).forEach(w => {
                const balance = parseFloat(w.balance) || 0;
                const option = document.createElement('option');
                option.value = w.id;
                option.dataset.balance = balance;
                option.dataset.devise = w.currency;
                option.textContent = `${w.country} — ${balance.toFixed(2)} ${w.currency}`;
                select.appendChild(option);
            });
        })
        .catch(e => console.error('Error loading wallets:', e));
}

// Search users for transfer
let transferSearchTimeout;
document.addEventListener('DOMContentLoaded', function() {
    const transferInput = document.getElementById('transferSearchUser');
    if (transferInput) {
        transferInput.addEventListener('input', function() {
            clearTimeout(transferSearchTimeout);
            const query = this.value;

            if (query.length < 2) {
                document.getElementById('transferSearchResults').innerHTML = '';
                return;
            }

            transferSearchTimeout = setTimeout(() => {
                fetch(`/transfer/search-users?q=${encodeURIComponent(query)}`)
                    .then(r => r.json())
                    .then(data => displayTransferResults(data.users))
                    .catch(e => console.error('Search error:', e));
            }, 300);
        });
    }

    // Wallet change
    document.getElementById('transferWalletId')?.addEventListener('change', function() {
        const selected = this.options[this.selectedIndex];
        const devise   = selected.dataset.devise || '—';
        const balance  = parseFloat(selected.dataset.balance) || 0;
        document.getElementById('transferDevise').textContent = devise;
        document.getElementById('transferBalanceInfo').textContent =
            balance > 0 ? `Available: ${balance.toFixed(2)} ${devise}` : '';
        updateTransferSummary();
    });

    // Amount change
    document.getElementById('transferAmount')?.addEventListener('input', updateTransferSummary);
});

function updateTransferSummary() {
    const amount  = parseFloat(document.getElementById('transferAmount').value) || 0;
    const devise  = document.getElementById('transferDevise').textContent;
    const walletSelect = document.getElementById('transferWalletId');
    const balance = parseFloat(walletSelect?.options[walletSelect.selectedIndex]?.dataset?.balance) || 0;
    const warning = document.getElementById('transferWarning');
    const sendBtn = document.getElementById('transferSendBtn');

    document.getElementById('transferSummaryAmount').textContent = `${amount.toFixed(2)} ${devise}`;

    if (amount > 0 && balance > 0 && amount > balance) {
        warning.innerHTML = '<span style="color:#dc3545;">⚠️ Amount exceeds wallet balance!</span>';
        if (sendBtn) sendBtn.disabled = true;
    } else {
        warning.textContent = '';
        if (sendBtn) sendBtn.disabled = false;
    }
}

function displayTransferResults(users) {
    const container = document.getElementById('transferSearchResults');

    if (!users || users.length === 0) {
        container.innerHTML = '<div style="text-align:center;padding:10px;color:#8faa8f;">No users found</div>';
        return;
    }

    container.innerHTML = users.map(user => `
        <div class="friend-search-item"
             data-id="${user.id}"
             data-name="${escapeHtml(user.name)}">
            <div class="friend-search-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div class="friend-search-info">
                <div class="friend-search-name">${escapeHtml(user.name)}</div>
                <div class="friend-search-email">${escapeHtml(user.email)}</div>
            </div>
        </div>
    `).join('');

    container.querySelectorAll('.friend-search-item').forEach(item => {
        item.addEventListener('click', function() {
            const userId   = this.dataset.id;
            const userName = this.dataset.name;

            document.getElementById('transferReceiverId').value    = userId;
            document.getElementById('transferReceiverName').textContent = userName;
            document.getElementById('transferSummaryReceiver').textContent = userName;

            document.getElementById('transferStep1').style.display = 'none';
            document.getElementById('transferStep2').style.display = 'block';
            document.getElementById('transferBackBtn').style.display = 'inline-block';
            document.getElementById('transferSendBtn').style.display = 'inline-block';
        });
    });
}

async function sendMoneyTransfer() {
    const receiverId     = document.getElementById('transferReceiverId').value;
    const senderWalletId = document.getElementById('transferWalletId').value;
    const amount         = parseFloat(document.getElementById('transferAmount').value);
    const message        = document.getElementById('transferMessage').value;

    if (!receiverId) { alert('Please select a friend'); return; }
    if (!senderWalletId) { alert('Please select a wallet'); return; }
    if (!amount || amount <= 0) { alert('Please enter a valid amount'); return; }

    const btn = document.getElementById('transferSendBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';

    try {
        const response = await fetch('/transfer/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ receiverId, senderWalletId, amount, message })
        });

        const data = await response.json();

        if (data.success) {
            alert('✅ ' + data.message);
            closeTransferModal();
        } else {
            alert('❌ ' + data.error);
        }
    } catch (e) {
        alert('❌ Server error');
    }

    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Money';
}
        var hasShownAlert = false;
        
        async function checkMaturityAlerts() {
            try {
                const response = await fetch('/alerts/maturity');
                const data = await response.json();
                
                if (data.hasAlerts && !hasShownAlert) {
                    showAlertPopup(data.alerts);
                    hasShownAlert = true;
                }
            } catch (error) {
                console.error('Error checking alerts:', error);
            }
        }
        
        function showAlertPopup(alerts) {
            const overlay = document.getElementById('maturityAlertOverlay');
            const content = document.getElementById('alertPopupContent');
            
            if (!overlay) return;
            
            if (alerts.length === 0) {
                content.innerHTML = `
                    <div class="alert-empty">
                        <i class="fas fa-check-circle"></i>
                        <p>No investments maturing soon!</p>
                    </div>
                `;
            } else {
                let alertsHtml = '';
                alerts.forEach(alert => {
                    const progressPercent = ((7 - alert.daysLeft) / 7) * 100;
                    alertsHtml += `
                        <div class="alert-card ${alert.severity}">
                            <div class="alert-card-header">
                                <span class="alert-card-title">💰 ${escapeHtml(alert.obligationName)}</span>
                                <span class="alert-badge ${alert.severity}">
                                    ${alert.daysLeft === 0 ? 'Today!' : `${alert.daysLeft} days left`}
                                </span>
                            </div>
                            <div class="alert-card-details">
                                <div class="alert-detail">
                                    <i class="fas fa-money-bill-wave"></i>
                                    <span>${alert.amount} DT</span>
                                </div>
                                <div class="alert-detail">
                                    <i class="fas fa-calendar-check"></i>
                                    <span>Matures: ${alert.maturityDate}</span>
                                </div>
                                <div class="alert-detail">
                                    <i class="fas fa-chart-line"></i>
                                    <span>Return: ${alert.expectedReturn} DT</span>
                                </div>
                            </div>
                            <div class="alert-progress">
                                <div class="alert-progress-bar">
                                    <div class="alert-progress-fill" style="width: ${progressPercent}%"></div>
                                </div>
                                <div class="alert-progress-text">
                                    ${alert.daysLeft === 0 ? 'Matures today!' : `${7 - alert.daysLeft} of 7 days passed`}
                                </div>
                            </div>
                        </div>
                    `;
                });
                content.innerHTML = alertsHtml;
            }
            
            overlay.style.display = 'flex';
            playNotificationSound();
        }
        
        function playNotificationSound() {
            try {
                const audio = new Audio('https://www.soundjay.com/misc/sounds/bell-ringing-05.mp3');
                audio.volume = 0.3;
                audio.play().catch(e => console.log('Sound play failed:', e));
            } catch(e) {}
        }
        
        function closeAlertPopup() {
            const overlay = document.getElementById('maturityAlertOverlay');
            if (overlay) {
                overlay.style.display = 'none';
            }
        }
        
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
