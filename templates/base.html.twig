            const data = {
                receiverId: document.getElementById('selectedUserId').value,
                obligationId: document.getElementById('obligationId').value,
                senderWalletId: document.getElementById('senderWalletId').value,
                amount: parseFloat(document.getElementById('loanAmount').value)
            };
            
            if (!data.receiverId) {
                alert('Please select a friend');
                return;
            }
            
            if (!data.obligationId) {
                alert('Please select an obligation');
                return;
            }
            
            if (!data.senderWalletId) {
                alert('Please select your wallet');
                return;
            }
            
            if (data.amount < 10) {
                alert('Minimum amount is 10 DT');
                return;
            }
            
            const btn = document.getElementById('friendSendRequest');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...';
            
            fetch('/friend-loan/send-request', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('✅ ' + data.message);
                    closeFriendLoanModal();
                    resetFriendModal();
                } else {
                    alert('❌ ' + data.error);
                }
            })
            .catch(error => {
                alert('❌ Error: ' + error.message);
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane"></i> Send Request';
            });
        }
        
        // Chatbot functions
        var isChatbotOpen = false;
        
        function toggleChatbot() {
            const window = document.getElementById('chatbotWindow');
            isChatbotOpen = !isChatbotOpen;
            if (isChatbotOpen) {
                window.classList.add('open');
            } else {
                window.classList.remove('open');
            }
        }
        
        async function sendChatbotMessage() {
            const input = document.getElementById('chatbotInput');
            const message = input.value.trim();
            
            if (!message) return;
            
            addChatbotMessage(message, 'user');
            input.value = '';
            showChatbotTyping();
            
            try {
                const response = await fetch('/api/chatbot/message', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });
                
                const data = await response.json();
                hideChatbotTyping();
                addChatbotMessage(data.response, 'bot');
            } catch (error) {
                hideChatbotTyping();
                addChatbotMessage('Sorry, an error occurred. Please try again.', 'bot');
            }
            
            scrollChatbotToBottom();
        }
        
        function addChatbotMessage(text, sender) {
            const container = document.getElementById('chatbotMessages');
            const messageDiv = document.createElement('div');
            messageDiv.className = `chatbot-message ${sender}`;
            const bubble = document.createElement('div');
            bubble.className = 'chatbot-bubble';
            bubble.innerHTML = text.replace(/\n/g, '<br>');
            messageDiv.appendChild(bubble);
            container.appendChild(messageDiv);
            scrollChatbotToBottom();
        }
        
        function showChatbotTyping() {
            const typing = document.getElementById('chatbotTyping');
            typing.style.display = 'block';
            scrollChatbotToBottom();
        }
        
        function hideChatbotTyping() {
            const typing = document.getElementById('chatbotTyping');
            typing.style.display = 'none';
        }
        
        function scrollChatbotToBottom() {
            const container = document.getElementById('chatbotMessages');
            container.scrollTop = container.scrollHeight;
        }
        
        function handleChatbotKeyPress(event) {
            if (event.key === 'Enter') {
                sendChatbotMessage();
            }
        }
        
        // Notification Functions
        function updateNotificationCount() {
            fetch('/notifications/unread-count')
                .then(response => response.json())
                .then(data => {
                    const badge = document.querySelector('#notificationBadge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count;
                            badge.style.display = 'flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                })
                .catch(error => console.error('Error updating count:', error));
        }
        
        function declineLoan(requestId) {
            if (confirm('Are you sure you want to decline this loan request?')) {
                fetch(`/friend-loan/respond/${requestId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'decline' })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('Request declined');
                        location.reload();
                    } else {
                        alert('Error: ' + data.error);
                    }
                })
                .catch(error => {
                    alert('Error: ' + error.message);
                });
            }
        }
        function acceptLoan(loanId) {
    console.log("Accepting loan: " + loanId);
    fetch('/friend-loan/respond/' + loanId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'accept' })
    })
    .then(response => response.json())
    .then(data => {
        console.log("Response data:", data);
        if (data.success && data.redirect) {
            window.location.href = data.redirect;
        } else if (data.error) {
            alert('Erreur: ' + data.error);
        }
    })
    .catch(error => {
        console.error('Erreur:', error);
        alert('Une erreur est survenue');
    });
}
        // Friend Loan Event Listeners
        document.addEventListener('DOMContentLoaded', function() {
            setTimeout(checkMaturityAlerts, 1000);
            
            // Search users
            const searchInput = document.getElementById('friendSearchUser');
            if (searchInput) {
                let searchTimeout;
                searchInput.addEventListener('input', function() {
                    clearTimeout(searchTimeout);
                    let query = this.value;
                    
                    if (query.length < 2) {
                        document.getElementById('friendSearchResults').innerHTML = '';
                        return;
                    }
                    
                    searchTimeout = setTimeout(function() {
                        fetch(`/friend-loan/search-users?q=${encodeURIComponent(query)}`)
                            .then(response => response.json())
                            .then(data => {
                                displayFriendResults(data.users);
                            })
                            .catch(error => {
                                console.error('Search error:', error);
                            });
                    }, 300);
                });
            }
            
            // Update summary on changes
            document.getElementById('obligationId')?.addEventListener('change', updateLoanSummary);
            document.getElementById('senderWalletId')?.addEventListener('change', updateLoanSummary);
            document.getElementById('loanAmount')?.addEventListener('input', updateLoanSummary);
            
            // Send request button
            const sendBtn = document.getElementById('friendSendRequest');
            if (sendBtn) {
                sendBtn.addEventListener('click', sendFriendLoanRequest);
            }
            
            // Back button
            const backBtn = document.getElementById('friendBackToSearch');
            if (backBtn) {
                backBtn.addEventListener('click', function() {
                    document.getElementById('friendStep2').style.display = 'none';
                    document.getElementById('friendStep1').style.display = 'block';
                    this.style.display = 'none';
                    document.getElementById('friendSendRequest').style.display = 'none';
                });
            }
            
            // Update notification count periodically
            updateNotificationCount();
            setInterval(updateNotificationCount, 30000);
        });
        
        function displayFriendResults(users) {
            const container = document.getElementById('friendSearchResults');
            if (!users || users.length === 0) {
                container.innerHTML = '<div style="text-align:center; padding:10px; color:#8faa8f;">No users found</div>';
                return;
            }
            
            let html = '';
            users.forEach(user => {
                html += `
                    <div class="friend-search-item" data-id="${user.id}" data-name="${user.name}">
                        <div class="friend-search-avatar">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="friend-search-info">
                            <div class="friend-search-name">${escapeHtml(user.name)}</div>
                            <div class="friend-search-email">${escapeHtml(user.email)}</div>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
            
            container.querySelectorAll('.friend-search-item').forEach(item => {
                item.addEventListener('click', function() {
                    const userId = this.dataset.id;
                    const userName = this.dataset.name;
                    
                    document.getElementById('selectedUserId').value = userId;
                    document.getElementById('selectedUserName').innerHTML = userName;
                    
                    // Charger les obligations et wallets avant d'afficher l'étape 2
                    loadObligationsAndWallets();
                    
                    document.getElementById('friendStep1').style.display = 'none';
                    document.getElementById('friendStep2').style.display = 'block';
                    document.getElementById('friendBackToSearch').style.display = 'inline-block';
                    document.getElementById('friendSendRequest').style.display = 'inline-block';
                    
                    // Attendre que les selects soient chargés
                    setTimeout(() => {
                        updateLoanSummary();
                    }, 500);
                });
            });
        }
    </script>

