    }
    
    .metric-card:hover {
        transform: translateY(-3px);
    }
    
    .metric-icon {
        width: 50px;
        height: 50px;
        background: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: #2d6a4f;
    }
    
    .metric-info {
        flex: 1;
    }
    
    .metric-info h5 {
        margin: 0 0 5px 0;
