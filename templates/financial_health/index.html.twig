    }
    
    .btn-primary {
        background-color: #2d6a4f;
        border-color: #2d6a4f;
    }
    
    .btn-primary:hover {
        background-color: #1b4d3b;
        border-color: #1b4d3b;
    }
    
    /* AI Section Styles */
    .display-4 {
        font-size: 2.5rem;
        font-weight: 600;
    }
    
    .ai-status {
        min-width: 100px;
        text-align: right;
    }
    
    /* Animation pour le chargement */
    @keyframes pulse {
        0% { opacity: 0.6; }
        100% { opacity: 1; }
    }
    
    .recommendation-card {
        transition: transform 0.2s ease;
    }
    
    .recommendation-card:hover {
        transform: translateX(5px);
