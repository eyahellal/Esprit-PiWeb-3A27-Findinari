    }
    
    .score-level.blue {
        background: #d1ecf1;
        color: #0c5460;
    }
    
    .score-level.yellow {
        background: #fff3cd;
        color: #856404;
    }
    
    .score-level.orange {
        background: #ffe5d0;
        color: #b45a0a;
    }
    
    .score-level.red {
        background: #f8d7da;
        color: #721c24;
    }
    
