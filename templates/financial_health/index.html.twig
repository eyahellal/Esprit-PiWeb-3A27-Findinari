</style>

<script>
document.addEventListener('DOMContentLoaded', async function() {
    await loadAIPrediction();
});

async function loadAIPrediction() {
    const loadingDiv = document.getElementById('aiLoading');
    const contentDiv = document.getElementById('aiContent');
    const statusSpan = document.getElementById('aiStatus');
    
    // Récupérer les métriques actuelles depuis le template Twig
    const currentScore = {{ score|default(0) }};
    const savingsRate = {{ metrics.savingsRate|default(0) }};
    const investmentRatio = {{ metrics.investmentRatio|default(0) }};
    const diversification = {{ metrics.diversification|default(0) }};
    const emergencyFund = {{ metrics.emergencyFund|default(0) }};
    const goalProgress = {{ metrics.goalProgress|default(0) }};
    const totalBalance = {{ totalBalance|default(0) }};
    const walletsCount = {{ walletsCount|default(0) }};
    const investmentsCount = {{ investmentsCount|default(0) }};
    
    // Préparer les données pour le ML
    const mlData = {
        current_score: currentScore,
        savings_rate: savingsRate,
        investment_ratio: investmentRatio,
        diversification: diversification,
        emergency_fund: emergencyFund,
        goal_progress: goalProgress,
        total_balance: totalBalance,
        wallets_count: walletsCount,
        investments_count: investmentsCount
    };
    
    loadingDiv.style.display = 'block';
    
    try {
        // Appel à ton API ML
        const response = await fetch('/api/ml/predict', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(mlData)
        });
        
        if (!response.ok) throw new Error('ML service not available');
        
        const result = await response.json();
        displayMLResults(result);
        loadingDiv.style.display = 'none';
        contentDiv.style.display = 'block';
        statusSpan.innerHTML = '<i class="fas fa-circle me-1" style="font-size: 8px;"></i> AI Ready';
        statusSpan.className = 'badge bg-success';
        
    } catch (error) {
        console.error('ML prediction error:', error);
        loadingDiv.style.display = 'none';
        contentDiv.style.display = 'block';
        statusSpan.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Demo Mode';
        statusSpan.className = 'badge bg-warning';
        
        // Mode démo - afficher des données simulées
        displayDemoResults(currentScore);
    }
}

function displayMLResults(result) {
    // Score prédit
    const predictedScore = result.predicted_score || result.prediction?.predicted_score || 0;
    const improvement = result.improvement || result.prediction?.improvement || 0;
    
    document.getElementById('predictedScore').textContent = predictedScore.toFixed(1);
    document.getElementById('scoreProgress').style.width = predictedScore + '%';
    
    const improvementBadge = document.getElementById('improvementBadge');
    if (improvement >= 0) {
        improvementBadge.innerHTML = `<i class="fas fa-arrow-up me-1"></i> +${improvement.toFixed(1)}%`;
        improvementBadge.className = 'badge bg-success ms-3';
    } else {
        improvementBadge.innerHTML = `<i class="fas fa-arrow-down me-1"></i> ${improvement.toFixed(1)}%`;
        improvementBadge.className = 'badge bg-danger ms-3';
    }
    
    // Forecast
    const future = result.future_predictions || [];
    if (future.length >= 3) {
        document.getElementById('forecast3').textContent = future[0].score.toFixed(1) + '%';
        document.getElementById('forecast6').textContent = future[1].score.toFixed(1) + '%';
        document.getElementById('forecast12').textContent = future[2].score.toFixed(1) + '%';
    }
    
    // Metrics
    if (result.metrics) {
        document.getElementById('metricNetGross').textContent = result.metrics.net_to_gross_ratio?.toFixed(1) + '%' || '--';
        document.getElementById('metricTaxRate').textContent = result.metrics.tax_rate?.toFixed(1) + '%' || '--';
        document.getElementById('metricCPP').textContent = result.metrics.cpp_ei_rate?.toFixed(1) + '%' || '--';
        
        document.getElementById('progressNetGross').style.width = (result.metrics.net_to_gross_ratio || 0) + '%';
        document.getElementById('progressTaxRate').style.width = Math.min(100, (result.metrics.tax_rate || 0)) + '%';
        document.getElementById('progressCPP').style.width = Math.min(100, (result.metrics.cpp_ei_rate || 0)) + '%';
    }
    
    document.getElementById('confidenceLevel').textContent = result.confidence ? 
        result.confidence.charAt(0).toUpperCase() + result.confidence.slice(1) : 'Medium';
    
    // Recommendations
    const recommendations = result.recommendations || [];
    const recContainer = document.getElementById('mlRecommendations');
    
    if (recommendations.length > 0) {
        let recHtml = '';
        recommendations.forEach(rec => {
            recHtml += `
                <div class="col-md-6">
                    <div class="border rounded-3 p-3 recommendation-card ${rec.type}">
                        <div class="d-flex align-items-start gap-3">
                            <div class="recommendation-icon-mini">${rec.type === 'savings' ? '💰' : rec.type === 'employment' ? '💼' : rec.type === 'investment' ? '📈' : '💡'}</div>
                            <div>
                                <h6 class="mb-1">${rec.title}</h6>
                                <p class="small text-muted mb-2">${rec.message}</p>
                                <small class="text-primary"><i class="fas fa-arrow-right me-1"></i> ${rec.action}</small>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });
        recContainer.innerHTML = recHtml;
    } else {
        recContainer.innerHTML = `
            <div class="col-12">
                <div class="text-center py-3 text-muted">
                    <i class="fas fa-check-circle text-success me-2"></i>
                    You're doing great! No specific recommendations at this time.
                </div>
            </div>
        `;
    }
}

function displayDemoResults(currentScore) {
    // Mode démo - simulation
    const predictedScore = Math.min(100, currentScore + 8);
    document.getElementById('predictedScore').textContent = predictedScore.toFixed(1);
    document.getElementById('scoreProgress').style.width = predictedScore + '%';
    document.getElementById('improvementBadge').innerHTML = `<i class="fas fa-arrow-up me-1"></i> +${(predictedScore - currentScore).toFixed(1)}%`;
    
    document.getElementById('forecast3').textContent = Math.min(100, predictedScore + 4).toFixed(1) + '%';
    document.getElementById('forecast6').textContent = Math.min(100, predictedScore + 9).toFixed(1) + '%';
    document.getElementById('forecast12').textContent = Math.min(100, predictedScore + 15).toFixed(1) + '%';
    
    document.getElementById('metricNetGross').textContent = '72.5%';
    document.getElementById('metricTaxRate').textContent = '15.2%';
    document.getElementById('metricCPP').textContent = '6.8%';
    document.getElementById('progressNetGross').style.width = '72.5%';
    document.getElementById('progressTaxRate').style.width = '15.2%';
    document.getElementById('progressCPP').style.width = '6.8%';
    document.getElementById('confidenceLevel').textContent = 'Medium';
    
    document.getElementById('mlRecommendations').innerHTML = `
        <div class="col-md-6">
            <div class="border rounded-3 p-3 recommendation-card savings">
                <div class="d-flex align-items-start gap-3">
                    <div class="recommendation-icon-mini">💰</div>
                    <div>
                        <h6 class="mb-1">💪 Watch Your Net Income Ratio</h6>
                        <p class="small text-muted mb-2">Your current net-to-gross ratio could be improved with better tax planning.</p>
                        <small class="text-primary"><i class="fas fa-arrow-right me-1"></i> Consider RRSP contributions to reduce taxable income</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 recommendation-card diversification">
                <div class="d-flex align-items-start gap-3">
                    <div class="recommendation-icon-mini">📊</div>
                    <div>
                        <h6 class="mb-1">🔄 Diversify Your Income Sources</h6>
                        <p class="small text-muted mb-2">Adding freelance or investment income could improve your financial resilience.</p>
                        <small class="text-primary"><i class="fas fa-arrow-right me-1"></i> Explore side hustle opportunities</small>
                    </div>
                </div>
            </div>
        </div>
    `;
}
