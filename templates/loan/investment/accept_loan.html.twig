{# templates/loan/accept_loan.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accept Loan Request{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center rounded-top-4 py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-hand-holding-usd me-2"></i>
                        Accept Loan Request
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info">
                        <strong><i class="fas fa-user me-2"></i> Lender:</strong>
                        {{ loan.sender.nom }} {{ loan.sender.prenom }}<br>
                        <strong><i class="fas fa-envelope me-2"></i> Email:</strong>
                        {{ loan.sender.gmail }}
                    </div>

                    {% if obligation %}
                    <div class="alert alert-secondary">
                        <strong><i class="fas fa-chart-line me-2"></i> Obligation:</strong>
                        {{ obligation.nom }}<br>
                        <strong>Interest Rate:</strong> {{ obligation.tauxInteret }}%<br>
                        <strong>Duration:</strong> {{ obligation.duree }} months
                    </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>💰 Amount:</strong>
                            <span class="text-primary">{{ loan.amount|number_format(2) }} DT</span>
                        </div>
                        <div class="col-6">
                            <strong>📈 Interest Rate:</strong>
                            <span class="text-warning">{{ loan.interestRate }}%</span>
                        </div>
                        <div class="col-6 mt-2">
                            <strong>⏱️ Duration:</strong>
                            <span>{{ loan.durationMonths }} months</span>
                        </div>
                        <div class="col-6 mt-2">
                            <strong>💵 Interest:</strong>
                            <span class="text-success">{{ interest|number_format(2) }} DT</span>
                        </div>
                        <div class="col-12 mt-2">
                            <strong class="fs-5">💰 Total to repay:</strong>
                            <span class="fs-5 fw-bold text-success">{{ total|number_format(2) }} DT</span>
                        </div>
                    </div>

                    <hr>

                    <form method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                <i class="fas fa-wallet me-2"></i>Select your wallet to receive the money:
                            </label>
                            <select name="wallet_id" class="form-select form-select-lg" required>
                                <option value="">-- Choose your wallet --</option>
                                {% for wallet in wallets %}
                                    <option value="{{ wallet.id }}">
                                        {{ wallet.pays }} - {{ wallet.solde|number_format(2) }} {{ wallet.devise }}
                                    </option>
                                {% endfor %}
                            </select>
                            <div class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle"></i>
                                The money will be transferred directly to this wallet.
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-check-circle me-2"></i>
                                Confirm & Accept Loan
                            </button>
                            <a href="#" 
                               class="btn btn-outline-danger" 
                               onclick="event.preventDefault(); 
                                       if(confirm('Are you sure you want to decline this loan request?')) {
                                           fetch('{{ path('friend_loan_respond', {'id': loan.id}) }}', {
                                               method: 'POST',
                                               headers: {'Content-Type': 'application/json'},
                                               body: JSON.stringify({action: 'decline'})
                                           }).then(() => window.location.href = '{{ path('app_dashboard') }}');
                                       }">
                                <i class="fas fa-times-circle me-2"></i>
                                Decline Request
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-muted text-center rounded-bottom-4 py-3">
                    <small>
                        <i class="fas fa-clock me-1"></i>
                        This request expires on {{ loan.expiresAt|date('Y-m-d H:i') }}
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}