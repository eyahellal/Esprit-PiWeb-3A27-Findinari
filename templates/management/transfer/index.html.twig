{% extends 'base.html.twig' %}

{% block title %}Money Transfer{% endblock %}

{% block body %}
<div class="container py-4">

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show rounded-4">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #26474E;">
            <i class="fas fa-paper-plane me-2" style="color: #F27438;"></i>
            Money Transfer
        </h2>
        <button class="btn px-4 py-2 rounded-pill fw-bold text-white"
                style="background: #F27438;"
                data-bs-toggle="modal"
                data-bs-target="#transferModal">
            <i class="fas fa-plus me-2"></i>Send Money
        </button>
    </div>

    {# Stats Cards #}
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-3" style="background: #fff3ee;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#F27438;">
                        <i class="fas fa-paper-plane text-white"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Sent</div>
                        <div class="fw-bold fs-5" style="color:#26474E;">{{ sentTransfers|length }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-3" style="background: #e8f5e9;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#2d6a4f;">
                        <i class="fas fa-inbox text-white"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Received</div>
                        <div class="fw-bold fs-5" style="color:#26474E;">{{ receivedTransfers|length }}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-3" style="background: #e3f2fd;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                         style="width:50px;height:50px;background:#2CCED2;">
                        <i class="fas fa-clock text-white"></i>
                    </div>
                    <div>
                        <div class="small text-muted">Pending</div>
                        <div class="fw-bold fs-5" id="pendingCount" style="color:#26474E;">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        {# Pending Transfers (received) #}
        <div class="col-md-6">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-header border-0 rounded-top-4 py-3"
                     style="background: linear-gradient(135deg, #2CCED2, #26474E);">
                    <h5 class="mb-0 text-white fw-bold">
                        <i class="fas fa-bell me-2"></i>Pending Transfers
                    </h5>
                </div>
                <div class="card-body p-3" id="pendingTransfersList">
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-spinner fa-spin"></i> Loading...
                    </div>
                </div>
            </div>
        </div>

        {# Sent Transfers History #}
        <div class="col-md-6">
            <div class="card border-0 rounded-4 shadow-sm">
                <div class="card-header border-0 rounded-top-4 py-3"
                     style="background: linear-gradient(135deg, #F27438, #26474E);">
                    <h5 class="mb-0 text-white fw-bold">
                        <i class="fas fa-history me-2"></i>Transfer History
                    </h5>
                </div>
                <div class="card-body p-3">
                    {% if sentTransfers is empty and receivedTransfers is empty %}
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-exchange-alt fa-2x mb-2" style="color: #F27438;"></i>
                            <p>No transfers yet</p>
                        </div>
                    {% else %}
                        {% for transfer in sentTransfers %}
                            <div class="d-flex justify-content-between align-items-center p-2 mb-2 rounded-3"
                                 style="background: #fff3ee;">
                                <div>
                                    <i class="fas fa-arrow-up text-danger me-2"></i>
                                    <strong>To: {{ transfer.receiver.nom }} {{ transfer.receiver.prenom }}</strong><br>
                                    <small class="text-muted">{{ transfer.createdAt|date('Y-m-d H:i') }}</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-danger">-{{ transfer.amountFloat|number_format(2) }} {{ transfer.devise }}</span><br>
                                    <span class="badge rounded-pill
                                        {% if transfer.status == 'completed' %}bg-success
                                        {% elseif transfer.status == 'pending' %}bg-warning
                                        {% else %}bg-danger{% endif %}">
                                        {{ transfer.status }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}

                        {% for transfer in receivedTransfers %}
                            <div class="d-flex justify-content-between align-items-center p-2 mb-2 rounded-3"
                                 style="background: #e8f5e9;">
                                <div>
                                    <i class="fas fa-arrow-down text-success me-2"></i>
                                    <strong>From: {{ transfer.sender.nom }} {{ transfer.sender.prenom }}</strong><br>
                                    <small class="text-muted">{{ transfer.createdAt|date('Y-m-d H:i') }}</small>
                                </div>
                                <div class="text-end">
                                    <span class="fw-bold text-success">+{{ transfer.amountFloat|number_format(2) }} {{ transfer.devise }}</span><br>
                                    <span class="badge rounded-pill
                                        {% if transfer.status == 'completed' %}bg-success
                                        {% elseif transfer.status == 'pending' %}bg-warning
                                        {% else %}bg-danger{% endif %}">
                                        {{ transfer.status }}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

{# Transfer Modal #}
<div class="modal fade" id="transferModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0">
            <div class="modal-header border-0 rounded-top-4 py-3"
                 style="background: linear-gradient(135deg, #F27438, #26474E);">
                <h5 class="modal-title text-white fw-bold">
                    <i class="fas fa-paper-plane me-2"></i>Send Money
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">

                {# Step 1 — Search User #}
                <div id="transferStep1">
                    <label class="form-label fw-bold" style="color: #26474E;">
                        <i class="fas fa-user me-2" style="color: #F27438;"></i>
                        Search Friend
                    </label>
                    <input type="text"
                           id="transferSearchUser"
                           class="form-control rounded-3"
                           placeholder="Name, surname or email...">
                    <div id="transferSearchResults" class="list-group mt-2"
                         style="max-height: 200px; overflow-y: auto;"></div>
                </div>

                {# Step 2 — Transfer Details #}
                <div id="transferStep2" style="display: none;">
                    <div class="alert rounded-3 border-0 mb-3"
                         style="background: #fff3ee; color: #26474E;">
                        <i class="fas fa-user-check me-2" style="color: #F27438;"></i>
                        <strong>Sending to:</strong>
                        <span id="transferReceiverName" class="fw-bold"></span>
                        <input type="hidden" id="transferReceiverId">
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: #26474E;">
                                <i class="fas fa-wallet me-2" style="color: #F27438;"></i>
                                From Wallet
                            </label>
                            <select id="transferSenderWallet" class="form-select rounded-3">
                                <option value="">-- Select wallet --</option>
                                {% for wallet in wallets %}
                                    <option value="{{ wallet.id }}"
                                            data-solde="{{ wallet.solde }}"
                                            data-devise="{{ wallet.devise }}">
                                        {{ wallet.pays }} — {{ wallet.solde|number_format(2) }} {{ wallet.devise }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold" style="color: #26474E;">
                                <i class="fas fa-coins me-2" style="color: #F27438;"></i>
                                Amount
                            </label>
                            <div class="input-group">
                                <input type="number"
                                       id="transferAmount"
                                       class="form-control rounded-start-3"
                                       min="1"
                                       step="0.01"
                                       placeholder="0.00">
                                <span class="input-group-text rounded-end-3" id="transferDevise">—</span>
                            </div>
                            <small id="transferBalanceInfo" class="text-muted"></small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold" style="color: #26474E;">
                                <i class="fas fa-comment me-2" style="color: #F27438;"></i>
                                Message (optional)
                            </label>
                            <input type="text"
                                   id="transferMessage"
                                   class="form-control rounded-3"
                                   placeholder="Add a note...">
                        </div>
                    </div>

                    {# Summary #}
                    <div class="rounded-3 p-3 mt-3" style="background: #f0fdf4;">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Amount to send:</span>
                            <span class="fw-bold text-success" id="transferSummaryAmount">0.00</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Receiver:</span>
                            <span class="fw-bold" id="transferSummaryReceiver">—</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">Cancel</button>
                <button type="button"
                        id="transferBackBtn"
                        class="btn btn-outline-secondary rounded-pill px-4"
                        style="display:none;"
                        onclick="showTransferStep1()">
                    ← Back
                </button>
                <button type="button"
                        id="transferSendBtn"
                        class="btn rounded-pill px-4 fw-bold text-white"
                        style="background: #F27438; display:none;"
                        onclick="sendTransfer()">
                    <i class="fas fa-paper-plane me-2"></i>Send Money
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// ================================
// Search Users
// ================================
let searchTimeout;
document.getElementById('transferSearchUser').addEventListener('input', function() {
    clearTimeout(searchTimeout);
    const query = this.value;

    if (query.length < 2) {
        document.getElementById('transferSearchResults').innerHTML = '';
        return;
    }

    searchTimeout = setTimeout(() => {
        fetch('/transfer/search-users?q=' + encodeURIComponent(query))
            .then(r => r.json())
            .then(data => displayTransferUsers(data.users));
    }, 300);
});

function displayTransferUsers(users) {
    const container = document.getElementById('transferSearchResults');

    if (users.length === 0) {
        container.innerHTML = '<div class="list-group-item text-muted text-center">No users found</div>';
        return;
    }

    container.innerHTML = users.map(user => `
        <a href="#" class="list-group-item list-group-item-action"
           onclick="selectTransferUser(${user.id}, '${user.name}'); return false;">
            <div class="d-flex align-items-center gap-2">
                <img src="${user.avatar}" class="rounded-circle" width="35" height="35">
                <div>
                    <strong>${user.name}</strong><br>
                    <small class="text-muted">${user.email}</small>
                </div>
            </div>
        </a>
    `).join('');
}

function selectTransferUser(userId, userName) {
    document.getElementById('transferReceiverId').value = userId;
    document.getElementById('transferReceiverName').textContent = userName;
    document.getElementById('transferSummaryReceiver').textContent = userName;

    document.getElementById('transferStep1').style.display = 'none';
    document.getElementById('transferStep2').style.display = 'block';
    document.getElementById('transferBackBtn').style.display = 'inline-block';
    document.getElementById('transferSendBtn').style.display = 'inline-block';
}

function showTransferStep1() {
    document.getElementById('transferStep1').style.display = 'block';
    document.getElementById('transferStep2').style.display = 'none';
    document.getElementById('transferBackBtn').style.display = 'none';
    document.getElementById('transferSendBtn').style.display = 'none';
}

// Update balance info and devise
document.getElementById('transferSenderWallet').addEventListener('change', function() {
    const selected = this.options[this.selectedIndex];
    const solde    = selected.dataset.solde;
    const devise   = selected.dataset.devise;

    document.getElementById('transferDevise').textContent = devise || '—';
    document.getElementById('transferBalanceInfo').textContent =
        solde ? `Available: ${parseFloat(solde).toFixed(2)} ${devise}` : '';
});

// Update summary
document.getElementById('transferAmount').addEventListener('input', function() {
    const amount  = parseFloat(this.value) || 0;
    const devise  = document.getElementById('transferDevise').textContent;
    document.getElementById('transferSummaryAmount').textContent =
        amount.toFixed(2) + ' ' + devise;
});

// ================================
// Send Transfer
// ================================
async function sendTransfer() {
    const receiverId     = document.getElementById('transferReceiverId').value;
    const senderWalletId = document.getElementById('transferSenderWallet').value;
    const amount         = parseFloat(document.getElementById('transferAmount').value);
    const message        = document.getElementById('transferMessage').value;

    if (!receiverId || !senderWalletId || amount <= 0) {
        alert('Please fill all required fields');
        return;
    }

    const btn = document.getElementById('transferSendBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';

    try {
        const response = await fetch('/transfer/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ receiverId, senderWalletId, amount, message })
        });

        const data = await response.json();

        if (data.success) {
            alert('✅ ' + data.message);
            bootstrap.Modal.getInstance(document.getElementById('transferModal')).hide();
            location.reload();
        } else {
            alert('❌ ' + data.error);
        }
    } catch (e) {
        alert('❌ Server error');
    }

    btn.disabled = false;
    btn.innerHTML = '<i class="fas fa-paper-plane me-2"></i>Send Money';
}

// ================================
// Load Pending Transfers
// ================================
async function loadPendingTransfers() {
    const response  = await fetch('/transfer/pending');
    const data      = await response.json();
    const transfers = data.transfers;
    const container = document.getElementById('pendingTransfersList');

    document.getElementById('pendingCount').textContent = transfers.length;

    if (transfers.length === 0) {
        container.innerHTML = `
            <div class="text-center text-muted py-4">
                <i class="fas fa-inbox fa-2x mb-2" style="color: #2CCED2;"></i>
                <p>No pending transfers</p>
            </div>`;
        return;
    }

    container.innerHTML = transfers.map(t => `
        <div class="d-flex justify-content-between align-items-center p-3 mb-2 rounded-3"
             style="background: #e3f2fd;">
            <div>
                <i class="fas fa-money-bill-wave me-2" style="color: #2CCED2;"></i>
                <strong>${t.senderName}</strong> sent you<br>
                <span class="fw-bold fs-5" style="color: #2d6a4f;">
                    ${t.amount.toFixed(2)} ${t.devise}
                </span><br>
                ${t.message ? `<small class="text-muted">"${t.message}"</small><br>` : ''}
                <small class="text-muted">${t.createdAt}</small>
            </div>
            <a href="/transfer/accept/${t.id}"
               class="btn btn-sm fw-bold text-white rounded-pill px-3"
               style="background: #2CCED2;">
                <i class="fas fa-wallet me-1"></i>Choose Wallet
            </a>
        </div>
    `).join('');
}

loadPendingTransfers();
setInterval(loadPendingTransfers, 30000);
</script>
{% endblock %}